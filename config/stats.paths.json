{
  "version": 1,
  "description": "Central logical path map for the Stats application. Resolve these paths from STATS_APP_ROOT at runtime instead of hardcoding a physical root such as C:\\000_Capstone or /app.",
  "runtime": {
    "rootEnvironmentVariable": "STATS_APP_ROOT",
    "defaultLocalRoot": ".",
    "defaultContainerRoot": "/app",
    "storageProviderEnvironmentVariable": "STATS_STORAGE_PROVIDER",
    "defaultStorageProvider": "LocalFileSystem",
    "cloudStorageProviderExample": "AzureBlobStorage"
  },
  "apps": {
    "statsWeb": "apps/stats-web",
    "statsData": "apps/stats-data",
    "statsAdminTools": "apps/stats-admin-tools"
  },
  "modules": {
    "identityAccess": "modules/identity-access-module",
    "fileValidation": "modules/file-validation-module",
    "documentParsing": "modules/document-parsing-module",
    "transactionExtraction": "modules/transaction-extraction-module",
    "dataValidation": "modules/data-validation-module",
    "emailIngestion": "modules/email-ingestion-module"
  },
  "contracts": {
    "root": "contracts",
    "identity": "contracts/identity",
    "documents": "contracts/documents",
    "extraction": "contracts/extraction",
    "transactions": "contracts/transactions"
  },
  "infrastructure": {
    "root": "infrastructure",
    "compose": "infrastructure/compose",
    "containers": "infrastructure/containers",
    "cloud": "infrastructure/cloud",
    "statsContainer": "infrastructure/containers/stats",
    "statsComposeFile": "infrastructure/compose/stats-runtime.compose.yml",
    "containerEnvFile": "infrastructure/compose/.env.container"
  },
  "tests": {
    "root": "tests",
    "unit": "tests/unit",
    "integration": "tests/integration",
    "scripts": "tests/scripts",
    "scriptConfig": "tests/scripts/config",
    "input": "tests/input",
    "results": "tests/results",
    "dockerRegressionResults": "tests/results/DockerRegression",
    "containerFirstResults": "tests/results/M13-ContainerFirstTesting"
  },
  "docs": {
    "root": "docs",
    "evidence": "docs/evidence",
    "specs": "docs/specs",
    "modulePlans": "docs/module-plans"
  },
  "samples": {
    "root": "samples",
    "synthetic": "samples/synthetic",
    "anonymized": "samples/anonymized"
  },
  "storage": {
    "localDataRoot": "apps/stats-data/data",
    "intake": "apps/stats-data/data/intake",
    "processing": "apps/stats-data/data/processing",
    "validationHandoff": "apps/stats-data/data/validation-handoff",
    "exports": "apps/stats-data/data/exports"
  }
}
