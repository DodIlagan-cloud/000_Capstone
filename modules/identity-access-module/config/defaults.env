# M1 - User Access Management Start
# Provides committed local runtime defaults for the standalone Identity Access Module.
APP_NAME=Identity Access Module
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

DATABASE_PROVIDER=AzureSql
DATABASE_SCHEMA=dbo
AZURE_SQL_CONNECTIONSTRING=
DATABASE_ECHO=false

ACCESS_TOKEN_SECRET_KEY=development-only-change-me
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_SCHEME=pbkdf2_sha256
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

LOG_LEVEL=INFO
# M1 End
