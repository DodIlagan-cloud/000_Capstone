# M1 - User Access Management Start
# Example local environment settings for the standalone Identity Access Module.
APP_NAME=Identity Access Module
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=*

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stats
DATABASE_ECHO=false

ACCESS_TOKEN_SECRET_KEY=replace-with-a-strong-local-secret
ACCESS_TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_HASH_SCHEME=pbkdf2_sha256

# Used only to bootstrap the first admin; the admin must set a new password on first login.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
LOG_LEVEL=INFO

# M1 End
