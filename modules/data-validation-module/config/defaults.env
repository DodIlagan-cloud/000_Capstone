APP_NAME=Data Validation Module
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8017
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
DEFAULT_CURRENCY=PHP
MIN_RECORD_CONFIDENCE=0.65
DUPLICATE_MATCH_AMOUNT_TOLERANCE=0.01
REQUIRE_TRANSACTION_DATE=true
REQUIRE_TRANSACTION_DIRECTION=true
ENABLE_DUPLICATE_DETECTION=true
MAX_RECORDS_PER_REQUEST=1000
