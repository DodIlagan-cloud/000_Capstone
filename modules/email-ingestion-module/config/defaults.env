APP_NAME=Email Ingestion Module
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8019
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
ACCESS_TOKEN_SECRET_KEY=development-only-change-me
ACCESS_TOKEN_ALGORITHM=HS256
EMAIL_PROVIDER=synthetic
EMAIL_INGESTION_MODE=dry_run
FILE_INGESTION_BASE_URL=http://localhost:8014
# Database-ingest path targets (process-imported / scheduled ingest). The container
# start script overrides these from the module port vars; these are safe local defaults.
DOCUMENT_PARSING_BASE_URL=http://localhost:8015
TRANSACTION_EXTRACTION_BASE_URL=http://localhost:8016
DATA_VALIDATION_BASE_URL=http://localhost:8017
STATS_DATA_BASE_URL=http://localhost:8018
EMAIL_SOURCE_CONFIG_STORE=memory
EMAIL_SECRET_PROVIDER=environment
EMAIL_SECRET_ENCRYPTION_KEY=
EMAIL_KEY_VAULT_URL=
ALLOWED_ATTACHMENT_EXTENSIONS=.pdf
ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf
MAX_ATTACHMENT_SIZE_BYTES=26214400
DEFAULT_MAILBOX_FOLDER=Inbox
# IMAP retrieval window: runs search SINCE (now - lookback) unless the request
# provides received_after. 0 disables the window (whole-folder scan).
DEFAULT_LOOKBACK_HOURS=24
DEFAULT_MAX_MESSAGES=25
# Socket timeout for IMAP connections so an unreachable host cannot hang a run.
IMAP_TIMEOUT_SECONDS=30
# Timeout for the file-intake handoff upload (large PDFs need more than 10s).
HANDOFF_TIMEOUT_SECONDS=60
POLLING_ENABLED=false
REDACT_EMAIL_SUBJECTS=true
PDF_PASSWORD_SECRET_PREFIX=stats-pdf-password
# Blocks IMAP hosts that resolve to private/loopback/link-local/reserved ranges
# (SSRF protection). Set false only when intentionally using an internal mail host.
BLOCK_PRIVATE_IMAP_HOSTS=true
# Optional comma-separated allowlist of permitted IMAP hostnames. Empty allows any
# public host subject to BLOCK_PRIVATE_IMAP_HOSTS.
ALLOWED_IMAP_HOSTS=
