APP_NAME=File Validation Module
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8014
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5013,http://localhost:5013
LOG_LEVEL=INFO
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
REQUIRE_KNOWN_SIGNATURE=true
COMPUTE_SHA256=true
STORAGE_ROOT=../../apps/stats-data/data/intake
DEFAULT_WORKFLOW=document-processing
MAX_STORED_FILE_SIZE_BYTES=10485760
