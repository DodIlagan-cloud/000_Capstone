APP_NAME=Transaction Extraction Module
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8016
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5013,http://localhost:5013
LOG_LEVEL=INFO
SUPPORTED_DOCUMENT_TYPES=statement,receipt,invoice,payment_proof,utility_bill,unknown
DEFAULT_CURRENCY=PHP
MIN_TRANSACTION_CONFIDENCE=0.55
MAX_TEXT_CHARS=100000
MAX_PAGE_COUNT=25
ENABLE_FIELD_EXTRACTION=true
ENABLE_TRANSACTION_ROWS=true
ENABLE_LINE_ITEMS=true
ENABLE_TRANSACTION_CLASSIFICATION=true
TRANSACTION_CLASSIFICATION_VOCABULARY_PATH=config/transaction-classification.vocabulary.json
TRANSACTION_CLASSIFICATION_RULES_PATH=config/transaction-classification.rules.json
SPENDING_CATEGORY_VOCABULARY_PATH=config/spending-category.vocabulary.json
SPENDING_CATEGORY_RULES_PATH=config/spending-category.rules.json
RECOGNITION_SETTINGS_URL=http://localhost:8018/api/v1/admin/recognition-settings/active
STATS_INTERNAL_API_KEY=
RECOGNITION_SETTINGS_CACHE_SECONDS=15
TRANSACTION_CLASSIFICATION_THRESHOLD=0.55
SPENDING_CATEGORY_THRESHOLD=0.55
TRANSACTION_CLASSIFICATION_AI_ENABLED=false
TRANSACTION_CLASSIFICATION_AI_PROVIDER=gemini
TRANSACTION_CLASSIFICATION_AI_ENDPOINT=
TRANSACTION_CLASSIFICATION_AI_API_KEY_ENV=GEMINI_API_KEY
TRANSACTION_CLASSIFICATION_AI_MODEL=gemini-2.5-flash
TRANSACTION_CLASSIFICATION_AI_MODEL_VERSION=gemini-2.5-flash
TRANSACTION_CLASSIFICATION_AI_MIN_CONFIDENCE=0.76
TRANSACTION_CLASSIFICATION_AI_TRIGGER_THRESHOLD=0.70
TRANSACTION_CLASSIFICATION_AI_MAX_CHARS=3000
