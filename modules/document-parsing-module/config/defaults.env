APP_NAME=Document Parsing Module
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8015
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5013,http://localhost:5013
LOG_LEVEL=INFO
SUPPORTED_MIME_TYPES=application/pdf,image/png,image/jpeg
MAX_DOCUMENT_SIZE_BYTES=10485760
ALLOW_DIRECT_TEXT=true
ALLOW_OCR_FALLBACK=false
OCR_ENGINE=none
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANGUAGES=eng
OCR_PSM_VALUES=6,11,4
OCR_RETRY_ORIENTATIONS=true
OCR_PDF_FAST_PSM_VALUES=6,4
OCR_IMAGE_FAST_PSM_VALUES=6,11
OCR_FAST_MIN_QUALITY_SCORE=0.55
OCR_FAST_MIN_TEXT_LENGTH=120
OCR_IMAGE_FAST_MIN_QUALITY_SCORE=0.62
OCR_IMAGE_FAST_MIN_TEXT_LENGTH=80
OCR_IMAGE_FAST_MIN_CONFIDENCE=50
OCR_PDF_RENDER_SCALE=2.0
OCR_MIN_CONFIDENCE=35
OCR_MIN_QUALITY_SCORE=0.35
OCR_MIN_ALNUM_RATIO=0.35
SUPPORTED_DOCUMENT_TYPES=statement,receipt,invoice,payment_proof,utility_bill,unknown
DOCUMENT_CLASSIFICATION_VOCABULARY_PATH=config/document-classification.vocabulary.json
DOCUMENT_CLASSIFICATION_RULES_PATH=config/document-classification.rules.json
RECOGNITION_SETTINGS_URL=http://localhost:8018/api/v1/admin/recognition-settings/active
STATS_INTERNAL_API_KEY=
RECOGNITION_SETTINGS_CACHE_SECONDS=15
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
CLASSIFICATION_ALLOW_UNKNOWN=true
CLASSIFICATION_AI_ENABLED=false
CLASSIFICATION_AI_PROVIDER=openai
CLASSIFICATION_AI_ENDPOINT=
CLASSIFICATION_AI_API_KEY_ENV=OPENAI_API_KEY
CLASSIFICATION_AI_MODEL=gpt-4o-mini
CLASSIFICATION_AI_MODEL_VERSION=gpt-4o-mini
CLASSIFICATION_AI_MIN_CONFIDENCE=0.76
CLASSIFICATION_AI_TRIGGER_THRESHOLD=0.70
CLASSIFICATION_AI_MAX_CHARS=3000
EXTRACTION_TIMEOUT_SECONDS=30
MAX_PAGE_COUNT=25
MIN_TEXT_LENGTH=20
ALLOW_DOCUMENT_REFERENCES=true
DOCUMENT_REFERENCE_ROOTS=../file-validation-module/data/intake
REDACT_EVIDENCE_OUTPUT=true
REDACTION_PREVIEW_CHARS=500
