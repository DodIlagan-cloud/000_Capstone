APP_NAME=Document Parsing Module
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8015
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5013,http://localhost:5013
LOG_LEVEL=INFO
SUPPORTED_MIME_TYPES=application/pdf,image/png,image/jpeg
MAX_DOCUMENT_SIZE_BYTES=10485760
ALLOW_DIRECT_TEXT=true
ALLOW_OCR_FALLBACK=false
OCR_ENGINE=none
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_LANGUAGES=eng
OCR_PSM_VALUES=6,11,4
OCR_RETRY_ORIENTATIONS=true
OCR_MIN_CONFIDENCE=35
OCR_MIN_QUALITY_SCORE=0.35
OCR_MIN_ALNUM_RATIO=0.35
SUPPORTED_DOCUMENT_TYPES=bank_statement,receipt,invoice,utility_bill,unknown
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
CLASSIFICATION_ALLOW_UNKNOWN=true
EXTRACTION_TIMEOUT_SECONDS=30
MAX_PAGE_COUNT=25
MIN_TEXT_LENGTH=20
ALLOW_DOCUMENT_REFERENCES=true
DOCUMENT_REFERENCE_ROOTS=../file-validation-module/data/intake
REDACT_EVIDENCE_OUTPUT=true
REDACTION_PREVIEW_CHARS=500
