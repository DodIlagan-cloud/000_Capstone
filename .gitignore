# M0 Foundation: repository ignore rules for generated files and local-only artefacts.

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Local runtime output
stats_ingestion.db
uploads/
apps/stats-data/data/
*.log

# Test evidence is retained locally until the final evidence check-in.
test-results/
tests/results/
tests/Stats_Module_Test_Case_Tracker.xlsx
tests/~$*.xlsx

# Local test fixtures and machine-specific test helper settings stay local.
tests/input/*
!tests/input/README.md
tests/scripts/config/test-script-settings.local.json

# Keeps local config overrides with secrets or developer-specific values out of source control.
**/.env
infrastructure/compose/.env.container
~$*.xlsx

# .NET build output
**/bin/
**/obj/

# Local document rendering checks
docx_render_check/

# IDE/local tool state
.qodo/
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store
