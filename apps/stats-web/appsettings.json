{
  "StatsApi": {
    "BaseUrl": "http://127.0.0.1:8013"
  },
  "StatsWeb": {
    "Features": {
      "UploadShell": true,
      "EmailIngestionSetup": true,
      "DashboardShell": true,
      "ReportsShell": true
    },
    "Downstream": {
      "FileValidationBaseUrl": "http://127.0.0.1:8014",
      "FileIngestionBaseUrl": "http://127.0.0.1:8014",
      "DocumentParsingBaseUrl": "http://127.0.0.1:8015",
      "EmailIngestionBaseUrl": "",
      "StatsDataBaseUrl": "",
      "ReportingEmbedConfigUrl": ""
    },
    "PowerBi": {
      "TenantId": "",
      "WorkspaceId": "",
      "DashboardReportId": "",
      "DatasetId": "",
      "EmbedMode": "AppOwnsData"
    },
    "Fabric": {
      "CapacityName": "",
      "WorkspaceName": "",
      "LakehouseName": "",
      "SemanticModelName": ""
    },
    "Azure": {
      "Environment": "local",
      "UseManagedIdentity": false,
      "KeyVaultUri": ""
    },
    "LocalOrchestration": {
      "Enabled": true,
      "StartMissingServices": true,
      "HealthCheckTimeoutSeconds": 2,
      "Services": [
        {
          "Name": "Identity Access API",
          "HealthUrl": "http://127.0.0.1:8013/health",
          "WorkingDirectory": "../../modules/identity-access-module",
          "Command": "python",
          "Arguments": "-m uvicorn app.main:app --host 127.0.0.1 --port 8013",
          "Environment": {
            "API_HOST": "127.0.0.1",
            "API_PORT": "8013"
          }
        },
        {
          "Name": "File Validation API",
          "HealthUrl": "http://127.0.0.1:8014/health",
          "WorkingDirectory": "../../modules/file-validation-module",
          "Command": "python",
          "Arguments": "-m uvicorn app.main:app --host 127.0.0.1 --port 8014",
          "Environment": {
            "API_HOST": "127.0.0.1",
            "API_PORT": "8014"
          }
        },
        {
          "Name": "Document Parsing API",
          "HealthUrl": "http://127.0.0.1:8015/health",
          "WorkingDirectory": "../../modules/document-parsing-module",
          "Command": "python",
          "Arguments": "-m uvicorn app.main:app --host 127.0.0.1 --port 8015",
          "Environment": {
            "API_HOST": "127.0.0.1",
            "API_PORT": "8015"
          }
        }
      ]
    }
  }
}
