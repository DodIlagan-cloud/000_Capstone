@page
@model ReportsModel
@* M2 - Stats Web Shell Start *@
@* Provides the authenticated reports shell before report generation exists. *@
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stats Reports</title>
    <link rel="stylesheet" href="/css/access.css" />
    <script src="/js/access.js" defer></script>
    <script src="/js/app.js" defer></script>
  </head>
  <body class="shell-page" data-api-base-url="@Model.ApiBaseUrl" data-shell-area="reports">
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="product-name">Stats</p>
          <h1>Reports</h1>
        </div>
        <nav class="header-actions" aria-label="Account actions">
          <a id="manage-users-link" href="/Users" hidden>Manage users</a>
          <button id="logout-button" type="button">Sign out</button>
        </nav>
      </header>

      <p id="app-message" class="page-message" role="status" aria-live="polite">Checking access.</p>

      <section id="landing-workspace" class="shell-workspace" hidden>
        <nav class="shell-nav" aria-label="Stats workspace navigation">
          <a href="/">Home</a>
          <a href="/Upload">Upload documents</a>
          <a href="/EmailSetup">Email ingestion setup</a>
          <a href="/Documents">Documents</a>
          <a href="/Reports" aria-current="page">Reports</a>
        </nav>

        <section class="shell-panel" aria-labelledby="reports-title">
          <p class="session-label">Reports</p>
          <h2 id="reports-title">Report area reserved</h2>
          <p class="panel-copy">Exports and financial report views are deferred until the reporting module defines persisted query and output requirements.</p>
          <div class="empty-state">Waiting for M11 Stats Dashboard and Reporting.</div>
        </section>
      </section>
    </main>
  </body>
</html>
@* M2 End *@
