@page
@model ReportsModel
@* Provides the authenticated analytics report host shell. *@
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stats Reports</title>
    <link rel="stylesheet" href="/css/access.css" />
    <script src="/js/access.js" defer asp-append-version="true"></script>
    <script src="/js/app.js" defer asp-append-version="true"></script>
    <script src="/js/reporting.js" defer asp-append-version="true"></script>
  </head>
  <body class="shell-page" data-api-base-url="@Model.ApiBaseUrl" data-shell-area="reports">
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="product-name">Stats</p>
          <h1>Reports</h1>
        </div>
        <nav class="header-actions" aria-label="Account actions">
          <a id="manage-users-link" data-admin-link href="/Users" hidden>Manage users</a>
          <a id="manage-classifications-link" data-admin-link href="/Admin/Classifications" hidden>Recognition settings</a>
          <button id="logout-button" type="button">Sign out</button>
        </nav>
      </header>

      <p id="app-message" class="page-message" role="status" aria-live="polite">Checking access.</p>

      <section id="landing-workspace" class="shell-workspace" hidden>
        <nav class="shell-nav" aria-label="Stats workspace navigation">
          <a href="/">Home</a>
          <a href="/Upload">Upload documents</a>
          <a href="/Documents">Documents</a>
          <a href="/Reports" aria-current="page">Reports</a>
          <a data-admin-link href="/EmailSetup" hidden>Email ingestion setup</a>
          <a data-admin-link href="/Admin/Classifications" hidden>Recognition settings</a>
        </nav>

        <section class="shell-panel reports-workbench" aria-labelledby="reports-title">
          <div class="dashboard-title-row">
            <div>
              <p class="session-label">Analytics reports</p>
              <h2 id="reports-title">Financial reports</h2>
              <p class="panel-copy">Explore spending movement, category readiness, source coverage, and review impact from curated financial records.</p>
            </div>
          </div>

            @if (Model.IsAdmin)
            {
          <section class="report-layout native-report-layout" aria-label="Analytics report area">
            <nav class="report-tabs" aria-label="Report sections">
              <div class="report-page-list" role="list">
                <button type="button" class="report-page-button" data-report-page="financial-overview" aria-pressed="true">Financial overview</button>
                <button type="button" class="report-page-button" data-report-page="spending-categories" aria-pressed="false">Spending categories</button>
                <button type="button" class="report-page-button" data-report-page="classification-quality" aria-pressed="false">Classification quality</button>
                <button type="button" class="report-page-button" data-report-page="source-coverage" aria-pressed="false">Source coverage</button>
                <button type="button" class="report-page-button" data-report-page="review-impact" aria-pressed="false">Review impact</button>
              </div>
            </nav>

            <div class="report-main">
              <section class="dashboard-control-bar report-control-bar" aria-label="Report controls">
                <label class="currency-control">
                  <span class="control-label">Currency</span>
                  <select id="reporting-currency" aria-label="Report currency">
                    <option selected="@(Model.ReportingDefaultCurrency == "NZD")">NZD</option>
                    <option selected="@(Model.ReportingDefaultCurrency == "PHP")">PHP</option>
                    <option selected="@(Model.ReportingDefaultCurrency == "AUD")">AUD</option>
                    <option selected="@(Model.ReportingDefaultCurrency == "USD")">USD</option>
                  </select>
                </label>
                <div>
                  <span class="control-label">Last updated</span>
                  <strong id="reporting-last-updated">@(Model.ReportingConfigured ? "Waiting for analytics refresh" : "Not connected")</strong>
                </div>
                <div>
                  <span class="control-label">Rate basis</span>
                  <strong id="reporting-rate-basis">Transaction date</strong>
                </div>
              </section>

              <p id="reporting-message" class="empty-state report-state-message" role="status" aria-live="polite" hidden></p>

              <section class="report-view is-active" data-report-panel="financial-overview" aria-labelledby="financial-overview-title">
                <div class="report-view-heading">
                  <div>
                    <p class="session-label">Financial overview</p>
                    <h3 id="financial-overview-title">Spending movement and reporting confidence</h3>
                    <p class="panel-copy">Use this view to understand expense movement first, then check whether classification and source quality are strong enough to trust category-level decisions.</p>
                  </div>
                </div>

                <section class="report-metric-grid" data-report-analytics aria-label="Financial overview metrics">
                  <article>
                    <span>Previous month</span>
                    <strong data-report-metric="last_month_expenses">Waiting</strong>
                    <p>Total debit spending in the prior calendar month.</p>
                  </article>
                  <article>
                    <span>Current month</span>
                    <strong data-report-metric="this_month_running">Waiting</strong>
                    <p>Running month-to-date expense total.</p>
                  </article>
                  <article>
                    <span>Movement</span>
                    <strong data-report-metric="expense_trend">Waiting</strong>
                    <p>Difference against the previous month.</p>
                  </article>
                </section>

                <section class="monthly-history-panel report-history-panel" aria-labelledby="report-monthly-history-title">
                  <div class="monthly-history-heading">
                    <div>
                      <p class="session-label">Monthly history</p>
                      <h3 id="report-monthly-history-title">Total expenses</h3>
                    </div>
                    <span id="monthly-history-currency">@Model.ReportingDefaultCurrency</span>
                  </div>
                  <div id="monthly-expense-history" class="monthly-history-chart" role="img" aria-label="Monthly total expense history">
                    <p class="panel-copy">Waiting for monthly expense history.</p>
                  </div>
                </section>

              </section>

              <section class="report-view" data-report-panel="spending-categories" aria-labelledby="spending-categories-title" hidden>
                <div class="report-view-heading">
                  <div>
                    <p class="session-label">Spending categories</p>
                    <h3 id="spending-categories-title">Where money is going</h3>
                    <p class="panel-copy">This view should compare expense totals by managed spending category and make uncategorized spending visible before conclusions are drawn.</p>
                  </div>
                </div>

                <section class="report-metric-grid" aria-label="Spending category summary">
                  <article>
                    <span>Top category</span>
                    <strong data-category-summary="top-category">Waiting</strong>
                    <p data-category-summary="top-category-detail">Ranked by expense total for the latest reporting month.</p>
                  </article>
                  <article>
                    <span>Uncategorized</span>
                    <strong data-category-summary="uncategorized-total">Waiting</strong>
                    <p>Expense value that still needs a usable category label.</p>
                  </article>
                  <article>
                    <span>Review items</span>
                    <strong data-category-summary="review-required">Waiting</strong>
                    <p>Category rows affected by review-required transactions.</p>
                  </article>
                </section>

                <section class="report-history-panel" aria-labelledby="category-breakdown-title">
                  <div class="monthly-history-heading">
                    <div>
                      <p class="session-label">Category breakdown</p>
                      <h3 id="category-breakdown-title">Latest month by spending category</h3>
                    </div>
                    <span data-category-summary="category-currency">@Model.ReportingDefaultCurrency</span>
                  </div>
                  <div id="spending-category-breakdown" class="category-breakdown-list" role="list">
                    <p class="panel-copy">Waiting for spending category data.</p>
                  </div>
                </section>
              </section>

              <section class="report-view" data-report-panel="classification-quality" aria-labelledby="classification-quality-title" hidden>
                <div class="report-view-heading">
                  <div>
                    <p class="session-label">Classification quality</p>
                    <h3 id="classification-quality-title">Can the categories be trusted?</h3>
                    <p class="panel-copy">Track classified, unclassified, low-confidence, and review-required transactions so category reports do not hide weak inputs.</p>
                  </div>
                </div>
                <section class="report-metric-grid" aria-label="Classification quality metrics">
                  <article>
                    <span>Coverage</span>
                    <strong data-classification-summary="coverage">Waiting</strong>
                    <p>Share of transactions with usable spending labels.</p>
                  </article>
                  <article>
                    <span>Unclassified</span>
                    <strong data-classification-summary="unclassified">Waiting</strong>
                    <p>Transactions that still need a category decision.</p>
                  </article>
                  <article>
                    <span>Review required</span>
                    <strong data-classification-summary="review-required">Waiting</strong>
                    <p>Rows that should be checked before trusting category totals.</p>
                  </article>
                </section>

                <section class="classification-coverage-panel" aria-labelledby="classification-coverage-title">
                  <div>
                    <p class="session-label">Classification readiness</p>
                    <h3 id="classification-coverage-title">Classified vs unclassified transactions</h3>
                    <p id="classification-coverage-detail" class="panel-copy">Waiting for classification quality data.</p>
                  </div>
                  <div class="coverage-meter" aria-hidden="true">
                    <span id="classification-coverage-bar"></span>
                  </div>
                </section>
              </section>

              <section class="report-view" data-report-panel="source-coverage" aria-labelledby="source-coverage-title" hidden>
                <div class="report-view-heading">
                  <div>
                    <p class="session-label">Source coverage</p>
                    <h3 id="source-coverage-title">What data supports the report?</h3>
                    <p class="panel-copy">Use this view to explain which source documents contributed to the reporting period and which records may be missing or incomplete.</p>
                  </div>
                </div>
                <section class="report-source-summary" aria-label="Source data summary">
                  <div>
                    <span>Source documents</span>
                    <strong>Documents tab</strong>
                    <p>Use the Documents page for source institutions, workflow status, parsed row counts, and quality status.</p>
                  </div>
                  <div>
                    <span>Reporting records</span>
                    <strong>Curated data</strong>
                    <p>Only saved records from the Stats Data layer should be included in financial reporting.</p>
                  </div>
                  <div>
                    <span>Trust context</span>
                    <strong>Review queue</strong>
                    <p>Review-required items and validation findings explain where a report total may need caution.</p>
                  </div>
                </section>
              </section>

              <section class="report-view" data-report-panel="review-impact" aria-labelledby="review-impact-title" hidden>
                <div class="report-view-heading">
                  <div>
                    <p class="session-label">Review impact</p>
                    <h3 id="review-impact-title">What needs attention before decisions?</h3>
                    <p class="panel-copy">Highlight extraction, validation, duplicate, and classification issues that can change financial totals or category conclusions.</p>
                  </div>
                </div>
                <section class="report-context-grid" aria-label="Review impact context">
                  <article>
                    <p class="session-label">High impact</p>
                    <h3>Large uncertain records</h3>
                    <p class="panel-copy">Prioritize high-value transactions with missing categories, validation findings, or possible duplicate matches.</p>
                  </article>
                  <article>
                    <p class="session-label">Repeated work</p>
                    <h3>Recurring unknowns</h3>
                    <p class="panel-copy">Repeated unknown descriptions should become recognition rules instead of remaining one-by-one fixes.</p>
                  </article>
                  <article>
                    <p class="session-label">Outcome</p>
                    <h3>Cleaner reports</h3>
                    <p class="panel-copy">Reducing review items improves the reliability of overview and category reporting.</p>
                  </article>
                </section>
              </section>
            </div>
          </section>
            }
            else
            {
              <p class="empty-state report-state-message" role="status">Financial reporting is limited to administrators until per-user analytics scoping is enabled.</p>
            }
        </section>
      </section>
    </main>
  </body>
</html>
