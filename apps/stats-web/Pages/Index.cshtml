@page
@model IndexModel
@* M1 - User Access Management Start *@
@* Module 1 authenticated landing page for users who completed login and password setup. *@
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stats App</title>
    <link rel="stylesheet" href="/css/access.css" />
    <script src="/js/access.js" defer asp-append-version="true"></script>
    <script src="/js/app.js" defer asp-append-version="true"></script>
    <script src="/js/reporting.js" defer asp-append-version="true"></script>
  </head>
  <body
    data-api-base-url="@Model.ApiBaseUrl"
    data-upload-shell-enabled="@Model.UploadShellEnabled.ToString().ToLowerInvariant()"
    data-dashboard-shell-enabled="@Model.DashboardShellEnabled.ToString().ToLowerInvariant()">
    <main class="app-shell">
      <header class="app-header">
        <div>
          <p class="product-name">Stats</p>
          @* M2 - Stats Web Shell Start *@
          @* Presents the authenticated Stats workspace shell entry point. *@
          <h1>Workspace</h1>
          @* M2 End *@
        </div>
        <nav class="header-actions" aria-label="Account actions">
          <a id="manage-users-link" data-admin-link href="/Users" hidden>Manage users</a>
          <a id="manage-classifications-link" data-admin-link href="/Admin/Classifications" hidden>Recognition settings</a>
          <button id="logout-button" type="button">Sign out</button>
        </nav>
      </header>

      <p id="app-message" class="page-message" role="status" aria-live="polite">Checking access.</p>

      <section id="landing-workspace" class="landing-workspace dashboard-workspace" hidden>
        <section class="summary-panel dashboard-user-banner" aria-labelledby="welcome-title">
          <p class="session-label">Authenticated access</p>
          <h2 id="welcome-title">Welcome, <span id="current-user-name"></span></h2>
          <dl class="session-facts">
            <div>
              <dt>Email</dt>
              <dd id="current-user-email"></dd>
            </div>
            <div>
              <dt>Role</dt>
              <dd id="current-user-role"></dd>
            </div>
          </dl>
        </section>

        @* Makes the authenticated workspace a financial dashboard shell. *@
        <section class="module-panel shell-overview" aria-label="Dashboard">
          <div class="dashboard-heading">
            <div class="dashboard-title-row">
              <div>
                <p class="session-label">Dashboard</p>
                <h2>Financial dashboard</h2>
                <p class="panel-copy">Financial KPIs from curated Stats data.</p>
              </div>
            </div>
          </div>

          <nav class="shell-nav" aria-label="Stats workspace navigation">
            <a href="/" aria-current="page">Home</a>
            <a href="/Upload">Upload documents</a>
            <a href="/EmailSetup">Email ingestion setup</a>
            <a href="/Documents">Documents</a>
            <a href="/Reports">Reports</a>
            <a data-admin-link href="/Admin/Classifications" hidden>Recognition settings</a>
          </nav>

          @if (Model.IsAdmin)
          {
            <section class="dashboard-control-bar" aria-label="Dashboard controls">
              <div>
                <span class="control-label">Last updated</span>
                <strong id="reporting-last-updated">@(Model.ReportingConfigured ? "Waiting for analytics refresh" : "Not connected")</strong>
              </div>
              <label class="currency-control">
                <span class="control-label">Currency</span>
                <select id="reporting-currency" aria-label="Dashboard reporting currency">
                  <option selected="@(Model.ReportingDefaultCurrency == "NZD")">NZD</option>
                  <option selected="@(Model.ReportingDefaultCurrency == "PHP")">PHP</option>
                  <option selected="@(Model.ReportingDefaultCurrency == "AUD")">AUD</option>
                  <option selected="@(Model.ReportingDefaultCurrency == "USD")">USD</option>
                </select>
              </label>
              <div>
                <span class="control-label">Rate basis</span>
                <strong id="reporting-rate-basis">Transaction date</strong>
              </div>
            </section>

            @if (!Model.ReportingConfigured)
            {
              <div id="reporting-message" class="empty-state powerbi-state" role="status">
                Analytics reporting is not connected yet. Stats can still show document provenance, upload status, review queues, and evidence workflow.
              </div>
            }
            else
            {
              <div id="reporting-message" class="empty-state powerbi-state" role="status" hidden></div>
            }

            <section class="dashboard-insight-layout" aria-label="Financial KPI dashboard">
              <div class="dashboard-primary-kpis" aria-label="Primary financial KPI cards">
                <article class="kpi-card primary-kpi" data-kpi-card="last_month_expenses">
                  <div class="kpi-card-header">
                    <p class="session-label">Last month expenses</p>
                  </div>
                  <h3 data-kpi-value>Waiting</h3>
                  <p data-kpi-detail>Total debit spending for the previous calendar month.</p>
                </article>
                <article class="kpi-card primary-kpi" data-kpi-card="this_month_running">
                  <div class="kpi-card-header">
                    <p class="session-label">This month running</p>
                  </div>
                  <h3 data-kpi-value>Waiting</h3>
                  <p data-kpi-detail>Month-to-date expense total in the selected currency.</p>
                </article>
                <article class="kpi-card primary-kpi emphasis-kpi" data-kpi-card="top_contributor">
                  <div class="kpi-card-header">
                    <p class="session-label">Top contributor</p>
                  </div>
                  <h3 data-kpi-value>Waiting</h3>
                  <p data-kpi-detail>Merchant, counterparty, or category driving current expenses.</p>
                </article>
              </div>

              <div class="dashboard-lower-grid">
                <section class="monthly-history-panel" aria-labelledby="monthly-history-title">
                  <div class="monthly-history-heading">
                    <div>
                      <p class="session-label">Monthly history</p>
                      <h3 id="monthly-history-title">Total expenses</h3>
                    </div>
                    <span id="monthly-history-currency">@Model.ReportingDefaultCurrency</span>
                  </div>
                  <div id="monthly-expense-history" class="monthly-history-chart" role="img" aria-label="Monthly total expense history">
                    <p class="panel-copy">Waiting for monthly expense history.</p>
                  </div>
                </section>

                <div class="dashboard-secondary-kpis" aria-label="Supporting financial KPI cards">
                  <article class="kpi-card compact-kpi" data-kpi-card="expense_trend">
                    <div class="kpi-card-header">
                      <p class="session-label">Change vs prior month</p>
                    </div>
                    <h3 data-kpi-value>Waiting</h3>
                    <p data-kpi-detail>This month spending minus the previous month.</p>
                  </article>
                  <article class="kpi-card compact-kpi" data-kpi-card="notable_expenses">
                    <div class="kpi-card-header">
                      <p class="session-label">Notable expenses</p>
                    </div>
                    <h3 data-kpi-value>Waiting</h3>
                    <p data-kpi-detail>Recent high-value or unusual expense movements.</p>
                  </article>
                </div>
              </div>
            </section>
          }

          <div class="next-actions" aria-label="Workspace actions">
            <a class="primary-action" href="/Upload">Upload documents</a>
            <a href="/Documents">View source documents</a>
            <a href="/Reports">Open reports</a>
          </div>
        </section>
      </section>
    </main>
  </body>
</html>
@* M1 End *@
