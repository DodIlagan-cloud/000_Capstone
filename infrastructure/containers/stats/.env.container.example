# M13 - Containerization Start
# Documents required environment variables for the Stats runtime container.
# Copy this file to infrastructure/compose/.env.container and fill in real values.
# Never commit .env.container — it contains secrets.

# -- Azure SQL ----------------------------------------------------------------
# Active M9/cloud-dev database target. Keep real values only in ignored local
# env files, Container Apps secrets, or Key Vault.
# Local Docker Compose uses this same AzureSql target. Copy this file to
# infrastructure/compose/.env.container and replace AZURE_SQL_CONNECTIONSTRING
# with a real ignored local value before running docker compose.
DATABASE_PROVIDER=AzureSql
DATABASE_SCHEMA=dbo
AZURE_SQL_SERVER=sql-stats-dev-001.database.windows.net
AZURE_SQL_DATABASE=sqldb-stats-dev
AZURE_SQL_CONNECTIONSTRING=replace-with-local-ignored-azure-sql-connection-string

# JWT signing secret. Use a long random string in production.
ACCESS_TOKEN_SECRET_KEY=replace-with-a-strong-secret-key

# Shared server-side key used by Stats Web when calling protected Stats Data
# admin endpoints. Keep real values in ignored env files, Container Apps
# secrets, or Key Vault. Do not expose this value to browser code.
STATS_INTERNAL_API_KEY=replace-with-a-strong-internal-api-key

# Optional: seed the first administrator account on first container run.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# -- OCR Configuration (M5) ---------------------------------------------------
# These are already set by the Dockerfile. Override only if your image layout differs.
# ALLOW_OCR_FALLBACK=true
# OCR_ENGINE=tesseract
# TESSERACT_CMD=/usr/bin/tesseract
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
# OCR_LANGUAGES=eng

# -- Stats Web ----------------------------------------------------------------
# Host port for Stats Web. Use STATS_WEB_HOST_PORT when the host port must differ.
STATS_WEB_HOST_PORT=8080
STATS_WEB_PORT=8080

# Optional reporting clock override for historical test runs. Leave blank for
# live/current reporting. Use yyyy-MM-dd, for example 2019-01-31.
STATS_AS_OF_DATE=
STATS_REPORTING_DEFAULT_CURRENCY=NZD
STATS_REPORTING_FX_RATES=

# Container-first test fixture locations. Compose also mounts the repository
# tests/input folder here so official module checks use approved real fixtures.
STATS_TESTDATA_DIR=/app/tests/input
STATS_PARSING_TESTDATA_DIR=/app/tests/input

# -- M11 Reporting / Fabric / Power BI ---------------------------------------
# Optional. Keep real tenant IDs, report IDs, client IDs, and secrets only in
# ignored local env files, Container Apps secrets, or Key Vault.
StatsWeb__PowerBi__TenantId=
StatsWeb__PowerBi__ClientId=
StatsWeb__PowerBi__ClientSecret=
StatsWeb__PowerBi__WorkspaceId=
StatsWeb__PowerBi__DashboardReportId=
StatsWeb__PowerBi__DatasetId=
StatsWeb__PowerBi__HomeDashboardPageName=
StatsWeb__PowerBi__ApiBaseUrl=https://api.powerbi.com/v1.0/myorg
StatsWeb__PowerBi__EmbedMode=AppOwnsData
StatsWeb__Fabric__CapacityName=
StatsWeb__Fabric__WorkspaceName=
StatsWeb__Fabric__LakehouseName=
StatsWeb__Fabric__SemanticModelName=

# -- Runtime Root and Storage -------------------------------------------------
# STATS_APP_ROOT is the physical root inside this runtime. Local development may
# use C:\000_Capstone; this container defaults to /app; cloud runtimes may differ.
STATS_APP_ROOT=/app
STATS_RUNTIME_CONFIG=/app/config/stats.runtime.json
STATS_PATHS_CONFIG=/app/config/stats.paths.json
STATS_LOGGING_CONFIG=/app/config/stats.logging.json
STATS_STORAGE_PROVIDER=AzureBlobStorage
STATS_VALIDATION_HANDOFF_DIR=/app/apps/stats-data/data/validation-handoff
STATS_DATA_PORT=8018
EMAIL_INGESTION_PORT=8019
AZURE_STORAGE_ACCOUNT_NAME=replace-with-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=replace-with-container-name
AZURE_STORAGE_BLOB_PREFIX=intake
AZURE_STORAGE_CONNECTION_STRING=replace-with-local-ignored-storage-connection-string

# -- Email Ingestion (M12) ----------------------------------------------------
# Keep real mailbox tokens, app secrets, refresh tokens, and webhook secrets out
# of this file. Use ignored local env files, Container Apps secrets, or Key Vault.
EMAIL_PROVIDER=synthetic
EMAIL_INGESTION_MODE=dry_run
FILE_INGESTION_BASE_URL=http://localhost:8014
EMAIL_SOURCE_CONFIG_STORE=azure_sql
EMAIL_SECRET_PROVIDER=azure_sql
EMAIL_KEY_VAULT_URL=
EMAIL_SECRET_ENCRYPTION_KEY=replace-with-local-ignored-email-secret-encryption-key
ALLOWED_ATTACHMENT_EXTENSIONS=.pdf
ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf
MAX_ATTACHMENT_SIZE_BYTES=26214400
DEFAULT_MAILBOX_FOLDER=Inbox
DEFAULT_LOOKBACK_HOURS=24
DEFAULT_MAX_MESSAGES=25
POLLING_ENABLED=false
REDACT_EMAIL_SUBJECTS=true
PDF_PASSWORD_SECRET_PREFIX=stats-pdf-password

# -- AI-assisted Classification (M5) ------------------------------------------
# Optional. Keep the real provider key only in ignored local env files, Container
# Apps secrets, or Key Vault. M5 sends redacted/truncated text only when enabled
# and the deterministic classification is weak, unknown, or ambiguous.
CLASSIFICATION_AI_ENABLED=false
CLASSIFICATION_AI_PROVIDER=openai
CLASSIFICATION_AI_ENDPOINT=
CLASSIFICATION_AI_API_KEY_ENV=OPENAI_API_KEY
CLASSIFICATION_AI_MODEL=gpt-4o-mini
CLASSIFICATION_AI_MODEL_VERSION=gpt-4o-mini
CLASSIFICATION_AI_MIN_CONFIDENCE=0.76
CLASSIFICATION_AI_TRIGGER_THRESHOLD=0.70
CLASSIFICATION_AI_MAX_CHARS=3000
TRANSACTION_CLASSIFICATION_AI_ENABLED=false
TRANSACTION_CLASSIFICATION_AI_PROVIDER=openai
TRANSACTION_CLASSIFICATION_AI_ENDPOINT=
TRANSACTION_CLASSIFICATION_AI_API_KEY_ENV=OPENAI_API_KEY
TRANSACTION_CLASSIFICATION_AI_MODEL=gpt-4o-mini
TRANSACTION_CLASSIFICATION_AI_MODEL_VERSION=gpt-4o-mini
TRANSACTION_CLASSIFICATION_AI_MIN_CONFIDENCE=0.76
TRANSACTION_CLASSIFICATION_AI_TRIGGER_THRESHOLD=0.70
TRANSACTION_CLASSIFICATION_AI_MAX_CHARS=3000
MERCHANT_CLASSIFICATION_LOOKUP_URL=http://localhost:8018/api/v1/internal/merchant-classifications/lookup
OPENAI_API_KEY=replace-with-local-ignored-openai-api-key

# Logging follows config/stats.logging.json.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_CORRELATION_ID=true
LOG_REDACT_SENSITIVE_VALUES=true
LOG_DESTINATION=stdout

# Override only if the image layout changes.
# IDENTITY_MODULE_DIR=/app/modules/identity-access-module
# FILE_VALIDATION_MODULE_DIR=/app/modules/file-validation-module
# DOCUMENT_PARSING_MODULE_DIR=/app/modules/document-parsing-module
# TRANSACTION_EXTRACTION_MODULE_DIR=/app/modules/transaction-extraction-module
# DATA_VALIDATION_MODULE_DIR=/app/modules/data-validation-module
# EMAIL_INGESTION_MODULE_DIR=/app/modules/email-ingestion-module
# STATS_WEB_DIR=/app/stats-web

# Allowed browser origins for module API CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# -- Service Ports (internal -- do not expose to host) ------------------------
# Override only if the default ports conflict inside the container.
# IDENTITY_PORT=8013
# FILE_VALIDATION_PORT=8014
# DOCUMENT_PARSING_PORT=8015

# M13 End
