# M14 - Cloud Readiness Start
# Safe example environment values for Azure Container Apps.
# Replace placeholders in the cloud control plane only. Do not commit real secrets.

# -- Environment --------------------------------------------------------------
STATS_ENVIRONMENT=cloud-dev
STATS_APP_ROOT=/app
STATS_RUNTIME_CONFIG=/app/config/stats.runtime.json
STATS_PATHS_CONFIG=/app/config/stats.paths.json
STATS_LOGGING_CONFIG=/app/config/stats.logging.json
# Optional yyyy-MM-dd reporting clock override for historical testing. Leave
# blank or omit for live/current reporting.
STATS_AS_OF_DATE=
STATS_REPORTING_DEFAULT_CURRENCY=NZD
STATS_REPORTING_FX_RATES=

# -- Runtime ------------------------------------------------------------------
STATS_WEB_PORT=8080
# Cloud-dev uses Azure SQL for database persistence and Azure Blob Storage for
# durable accepted-document storage.
STATS_STORAGE_PROVIDER=AzureBlobStorage
STATS_VALIDATION_HANDOFF_DIR=/app/apps/stats-data/data/validation-handoff
STATS_DATA_PORT=8018
STATS_INTERNAL_API_KEY=secretref:stats-internal-api-key
CORS_ALLOWED_ORIGINS=https://replace-with-stats-app-hostname.example

# -- Email Ingestion (M12) ----------------------------------------------------
# Mailbox app passwords and reusable PDF passwords must be stored in Key Vault.
# Do not place raw mailbox or PDF passwords in env files.
EMAIL_INGESTION_PORT=8019
EMAIL_PROVIDER=imap
EMAIL_INGESTION_MODE=handoff
EMAIL_SOURCE_CONFIG_STORE=azure_sql
EMAIL_SECRET_PROVIDER=azure_key_vault
EMAIL_KEY_VAULT_URL=https://replace-with-key-vault-name.vault.azure.net/
EMAIL_SECRET_ENCRYPTION_KEY=
FILE_INGESTION_BASE_URL=http://localhost:8014
ALLOWED_ATTACHMENT_EXTENSIONS=.pdf
ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf
MAX_ATTACHMENT_SIZE_BYTES=26214400
DEFAULT_MAILBOX_FOLDER=Inbox
DEFAULT_LOOKBACK_HOURS=24
DEFAULT_MAX_MESSAGES=25
POLLING_ENABLED=false
REDACT_EMAIL_SUBJECTS=true
PDF_PASSWORD_SECRET_PREFIX=stats-pdf-password

# -- Database: Azure SQL ------------------------------------------------------
DATABASE_PROVIDER=AzureSql
DATABASE_SCHEMA=dbo
AZURE_SQL_SERVER=sql-stats-dev-001.database.windows.net
AZURE_SQL_DATABASE=sqldb-stats-dev

# Prefer managed identity / Microsoft Entra authentication. If this connection
# string contains credentials, store it in Key Vault or Container Apps secrets.
AZURE_SQL_CONNECTIONSTRING=secretref:stats-azure-sql-connectionstring

# -- Identity -----------------------------------------------------------------
# Secret. Store in Key Vault or Container Apps secrets.
ACCESS_TOKEN_SECRET_KEY=secretref:stats-access-token-secret-key
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=secretref:stats-default-admin-password

# -- OCR ----------------------------------------------------------------------
ALLOW_OCR_FALLBACK=true
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
OCR_LANGUAGES=eng
OCR_PDF_FAST_PSM_VALUES=6,4
OCR_FAST_MIN_QUALITY_SCORE=0.55
OCR_FAST_MIN_TEXT_LENGTH=120
OCR_PDF_RENDER_SCALE=2.0

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_CORRELATION_ID=true
LOG_REDACT_SENSITIVE_VALUES=true
LOG_DESTINATION=stdout

# -- Azure Blob Storage -------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=replace-with-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=replace-with-container-name
AZURE_STORAGE_BLOB_PREFIX=intake
# Secret when connection string auth is used. Prefer managed identity once the
# storage identity/RBAC path is implemented.
AZURE_STORAGE_CONNECTION_STRING=secretref:stats-storage-connection-string
AZURE_CLIENT_ID=replace-with-managed-identity-client-id

# -- AI-assisted Classification (M5/M7) ---------------------------------------
# Cloud-dev must keep AI classification enabled. Secret values must come from
# Container Apps secrets or Key Vault; do not commit provider keys.
CLASSIFICATION_AI_ENABLED=true
CLASSIFICATION_AI_PROVIDER=openai
CLASSIFICATION_AI_ENDPOINT=
CLASSIFICATION_AI_API_KEY_ENV=OPENAI_API_KEY
CLASSIFICATION_AI_MODEL=gpt-4o-mini
CLASSIFICATION_AI_MODEL_VERSION=gpt-4o-mini
CLASSIFICATION_AI_MIN_CONFIDENCE=0.76
CLASSIFICATION_AI_TRIGGER_THRESHOLD=0.70
CLASSIFICATION_AI_MAX_CHARS=3000
TRANSACTION_CLASSIFICATION_AI_ENABLED=true
TRANSACTION_CLASSIFICATION_AI_PROVIDER=openai
TRANSACTION_CLASSIFICATION_AI_ENDPOINT=
TRANSACTION_CLASSIFICATION_AI_API_KEY_ENV=OPENAI_API_KEY
TRANSACTION_CLASSIFICATION_AI_MODEL=gpt-4o-mini
TRANSACTION_CLASSIFICATION_AI_MODEL_VERSION=gpt-4o-mini
TRANSACTION_CLASSIFICATION_AI_MIN_CONFIDENCE=0.76
TRANSACTION_CLASSIFICATION_AI_TRIGGER_THRESHOLD=0.70
TRANSACTION_CLASSIFICATION_AI_MAX_CHARS=3000
MERCHANT_CLASSIFICATION_LOOKUP_URL=http://localhost:8018/api/v1/internal/merchant-classifications/lookup
OPENAI_API_KEY=secretref:stats-openai-api-key

# -- Microsoft Fabric / Power BI ---------------------------------------------
FABRIC_WORKSPACE_ID=replace-with-fabric-workspace-id
FABRIC_LAKEHOUSE_ID=replace-with-fabric-lakehouse-or-warehouse-id
POWERBI_WORKSPACE_ID=replace-with-powerbi-workspace-id
POWERBI_REPORT_ID=replace-with-powerbi-report-id
POWERBI_TENANT_ID=replace-with-tenant-id
POWERBI_CLIENT_ID=replace-with-service-principal-client-id
POWERBI_CLIENT_SECRET=secretref:stats-powerbi-client-secret

# M14 - Cloud Readiness End
