# M14 - Cloud Readiness Start
# Safe example environment values for Azure Container Apps.
# Replace placeholders in the cloud control plane only. Do not commit real secrets.

# -- Environment --------------------------------------------------------------
STATS_ENVIRONMENT=cloud-dev
STATS_APP_ROOT=/app
STATS_RUNTIME_CONFIG=/app/config/stats.runtime.json
STATS_PATHS_CONFIG=/app/config/stats.paths.json
STATS_LOGGING_CONFIG=/app/config/stats.logging.json

# -- Runtime ------------------------------------------------------------------
STATS_WEB_PORT=8080
STATS_STORAGE_PROVIDER=LocalFileSystem
CORS_ALLOWED_ORIGINS=https://replace-with-stats-app-hostname.example

# -- Database: Azure SQL ------------------------------------------------------
DATABASE_PROVIDER=AzureSql
DATABASE_SCHEMA=dbo
AZURE_SQL_SERVER=sql-stats-dev-001.database.windows.net
AZURE_SQL_DATABASE=sqldb-stats-dev

# Prefer managed identity / Microsoft Entra authentication. If this connection
# string contains credentials, store it in Key Vault or Container Apps secrets.
AZURE_SQL_CONNECTIONSTRING=secretref:stats-azure-sql-connectionstring

# -- Identity -----------------------------------------------------------------
# Secret. Store in Key Vault or Container Apps secrets.
ACCESS_TOKEN_SECRET_KEY=secretref:stats-access-token-secret-key
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=secretref:stats-default-admin-password

# -- OCR ----------------------------------------------------------------------
ALLOW_OCR_FALLBACK=true
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
OCR_LANGUAGES=eng

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_CORRELATION_ID=true
LOG_REDACT_SENSITIVE_VALUES=true
LOG_DESTINATION=stdout

# -- Future Azure Blob Storage ------------------------------------------------
# Required only after the AzureBlobStorage provider is implemented.
AZURE_STORAGE_ACCOUNT_NAME=replace-with-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=replace-with-container-name
AZURE_CLIENT_ID=replace-with-managed-identity-client-id

# -- Microsoft Fabric / Power BI ---------------------------------------------
FABRIC_WORKSPACE_ID=replace-with-fabric-workspace-id
FABRIC_LAKEHOUSE_ID=replace-with-fabric-lakehouse-or-warehouse-id
POWERBI_WORKSPACE_ID=replace-with-powerbi-workspace-id
POWERBI_REPORT_ID=replace-with-powerbi-report-id
POWERBI_TENANT_ID=replace-with-tenant-id
POWERBI_CLIENT_ID=replace-with-service-principal-client-id
POWERBI_CLIENT_SECRET=secretref:stats-powerbi-client-secret

# M14 - Cloud Readiness End
